[Desktop Entry]
Type=Application
Name=Polkit-Anmeldedialog
Exec=sh -c 'for a in /usr/libexec/xfce-polkit /usr/lib/x86_64-linux-gnu/polkit-mate/polkit-mate-authentication-agent-1 /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1; do [ -x "$a" ] && exec "$a"; done'
OnlyShowIn=XFCE;
NoDisplay=true
