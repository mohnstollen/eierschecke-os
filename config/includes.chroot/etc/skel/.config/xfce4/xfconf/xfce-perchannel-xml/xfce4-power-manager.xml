<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-power-manager" version="1.0">
  <property name="xfce4-power-manager" type="empty">
    <property name="show-tray-icon" type="bool" value="false"/>
    <property name="general-notification" type="bool" value="true"/>
    <property name="handle-brightness-keys" type="bool" value="true"/>
    <property name="lock-screen-suspend-hibernate" type="bool" value="true"/>
    <property name="logind-handle-lid-switch" type="bool" value="false"/>
    <!-- Deckel zu = Standby -->
    <property name="lid-action-on-battery" type="uint" value="1"/>
    <property name="lid-action-on-ac" type="uint" value="1"/>
    <!-- Akku: nach 2 min auf 20 % dimmen, nach 5 min Bildschirm aus, nach 15 min Standby -->
    <property name="brightness-on-battery" type="uint" value="120"/>
    <property name="brightness-level-on-battery" type="uint" value="20"/>
    <property name="blank-on-battery" type="int" value="5"/>
    <property name="dpms-on-battery-sleep" type="uint" value="5"/>
    <property name="dpms-on-battery-off" type="uint" value="6"/>
    <property name="inactivity-on-battery" type="uint" value="15"/>
    <property name="inactivity-sleep-mode-on-battery" type="uint" value="1"/>
    <!-- Netz: nach 10 min Bildschirm aus, nach 45 min Standby -->
    <property name="blank-on-ac" type="int" value="10"/>
    <property name="dpms-on-ac-sleep" type="uint" value="10"/>
    <property name="dpms-on-ac-off" type="uint" value="12"/>
    <property name="inactivity-on-ac" type="uint" value="45"/>
    <property name="inactivity-sleep-mode-on-ac" type="uint" value="1"/>
    <property name="critical-power-level" type="uint" value="7"/>
    <property name="critical-power-action" type="uint" value="1"/>
  </property>
</channel>
