#!/usr/bin/env python3
"""Startet, beendet und aktualisiert das EierscheckeOS-Conky-Widget.

  eierschecke-conky start|stop|restart|status
"""
import os
import subprocess
import sys
import time

import eierschecke_konfig as konfig

# Eigene Vorlage > Installation im Benutzerkonto (conky/install.sh) > systemweit (EierscheckeOS)
VORLAGEN = [os.path.expanduser("~/.config/eierschecke/conkyrc.vorlage"),
            os.path.expanduser("~/.local/share/eierschecke/conky/conkyrc.vorlage"),
            "/usr/share/eierschecke/conky/conkyrc.vorlage"]
# Die Abruf-Skripte liegen neben diesem Skript – so klappt es auch ohne passenden PATH.
HIER = os.path.dirname(os.path.realpath(__file__))
CONKYRC = os.path.join(konfig.CACHE_ORDNER, "conkyrc")
TRENNER = "${voffset 6}${color2}${hr 1}${color}${voffset 4}\n"

SYSTEM = """${color1}${font Inter:bold:size=11}System${font}${color}
${if_existing /sys/class/power_supply/BAT0}Akku${goto 110}${battery_percent BAT0} %${alignr}${battery_bar 6,150 BAT0}
${endif}Prozessor${goto 110}${cpu cpu0} %${alignr}${cpubar cpu0 6,150}
Speicher${goto 110}${memperc} %${alignr}${membar 6,150}
Datenträger${goto 110}${fs_used_perc /} %${alignr}${fs_bar 6,150 /}
"""


def laeuft():
    return subprocess.run(["pgrep", "-u", str(os.getuid()), "-f", "conky .*" + CONKYRC],
                          stdout=subprocess.DEVNULL).returncode == 0


def stoppen():
    subprocess.run(["pkill", "-u", str(os.getuid()), "-f", "conky .*" + CONKYRC])


def conkyrc_schreiben(werte):
    abschnitte = []
    if konfig.an(werte, "WETTER"):
        abschnitte.append("${execpi 60 %s}\n" % os.path.join(HIER, "eierschecke-wetter"))
    if konfig.an(werte, "NACHRICHTEN"):
        abschnitte.append("${execpi 60 %s}\n" % os.path.join(HIER, "eierschecke-nachrichten"))
    if konfig.an(werte, "SYSTEM"):
        abschnitte.append(SYSTEM)
    if not abschnitte:
        return False
    vorlage = next(pfad for pfad in VORLAGEN if os.path.exists(pfad))
    with open(vorlage, encoding="utf-8") as datei:
        inhalt = datei.read().replace("@INHALT@", TRENNER.join(abschnitte).rstrip("\n") + "\n")
    os.makedirs(konfig.CACHE_ORDNER, exist_ok=True)
    with open(CONKYRC, "w", encoding="utf-8") as datei:
        datei.write(inhalt)
    return True


def starten(verzoegerung=0):
    werte = konfig.laden()
    if not os.path.exists(konfig.KONFIG_DATEI):
        konfig.speichern(werte)
    if not konfig.an(werte, "WIDGETS") or not conkyrc_schreiben(werte):
        return
    if laeuft():
        return
    if verzoegerung:
        time.sleep(verzoegerung)
    subprocess.Popen(["conky", "-q", "-c", CONKYRC], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    befehl = sys.argv[1] if len(sys.argv) > 1 else "start"
    if befehl == "start":
        starten(8 if "--autostart" in sys.argv else 0)
    elif befehl == "stop":
        stoppen()
    elif befehl == "restart":
        stoppen()
        time.sleep(0.5)
        starten()
    elif befehl == "status":
        print("läuft" if laeuft() else "aus")
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
