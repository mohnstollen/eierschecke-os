-- EierscheckeOS – Conky-Widget (Vorlage)
-- Diese Datei wird von "eierschecke-conky" mit den Werten aus
-- ~/.config/eierschecke/conky.conf gefüllt. Eigene Anpassungen überstehen
-- Updates, wenn sie als ~/.config/eierschecke/conkyrc.vorlage gespeichert werden.
conky.config = {
    alignment = 'top_right',
    gap_x = 24,
    gap_y = 32,
    minimum_width = 340,
    maximum_width = 340,
    border_inner_margin = 16,
    border_width = 0,

    own_window = true,
    own_window_class = 'Conky',
    own_window_title = 'EierscheckeOS-Widget',
    own_window_type = 'normal',
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    own_window_argb_visual = true,
    own_window_argb_value = 205,
    own_window_colour = '1e1e22',

    double_buffer = true,
    use_xft = true,
    font = 'Inter:size=10',
    override_utf8_locale = true,
    draw_shades = false,
    draw_outline = false,
    draw_borders = false,
    default_color = 'd8d4c8',
    color1 = 'e8b84a',
    color2 = '8a8a92',

    update_interval = 2,
    text_buffer_size = 8192,
    no_buffers = true,
    cpu_avg_samples = 2,
}

conky.text = [[
@INHALT@]]
