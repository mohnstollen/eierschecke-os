#!/usr/bin/env python3
"""Tagesschau-Schlagzeilen für das Conky-Widget (offizieller RSS-Feed).

Gibt Conky-Text aus. Die Daten liegen in ~/.cache/eierschecke/nachrichten.json; ohne
Netz bleiben die letzten Schlagzeilen stehen.
"""
import json
import os
import sys
import textwrap
import time
import urllib.request
import xml.etree.ElementTree as ET
from datetime import datetime

import eierschecke_konfig as konfig

FEED = "https://www.tagesschau.de/index~rss2.xml"
CACHE = os.path.join(konfig.CACHE_ORDNER, "nachrichten.json")
ZEILENBREITE = 46


def abrufen():
    anfrage = urllib.request.Request(FEED, headers={"User-Agent": "EierscheckeOS-Widget"})
    with urllib.request.urlopen(anfrage, timeout=10) as antwort:
        wurzel = ET.fromstring(antwort.read())
    titel = [(eintrag.findtext("title") or "").strip() for eintrag in wurzel.iter("item")]
    titel = [t for t in titel if t][:20]
    if not titel:
        raise ValueError("Feed ohne Einträge")
    daten = {"_abgerufen": time.time(), "titel": titel}
    os.makedirs(konfig.CACHE_ORDNER, exist_ok=True)
    with open(CACHE + ".neu", "w", encoding="utf-8") as datei:
        json.dump(daten, datei, ensure_ascii=False)
    os.replace(CACHE + ".neu", CACHE)
    return daten


def aus_cache():
    try:
        with open(CACHE, encoding="utf-8") as datei:
            return json.load(datei)
    except (OSError, ValueError):
        return None


def main():
    werte = konfig.laden()
    intervall = konfig.zahl(werte, "NACHRICHTEN_INTERVALL_MIN", 5, 720) * 60
    anzahl = konfig.zahl(werte, "NACHRICHTEN_ANZAHL", 1, 12)
    daten = aus_cache()
    if daten is None or time.time() - daten.get("_abgerufen", 0) >= intervall or "--neu" in sys.argv:
        try:
            daten = abrufen()
        except Exception:  # ohne Netz bleiben die letzten Schlagzeilen stehen
            pass
    kopf = "${color1}${font Inter:bold:size=11}Tagesschau${font}${color}"
    if daten is None:
        print(kopf + "\n${color2}Noch keine Schlagzeilen (kein Netz?)${color}")
        return
    stand = datetime.fromtimestamp(daten["_abgerufen"]).strftime("%H:%M")
    zeilen = [kopf + "${alignr}${color2}Stand %s${color}" % stand]
    for titel in daten["titel"][:anzahl]:
        teile = textwrap.wrap(titel, ZEILENBREITE, max_lines=2, placeholder=" …")
        for nummer, teil in enumerate(teile):
            vorsatz = "${color1}•${color} " if nummer == 0 else "   "
            zeilen.append(vorsatz + konfig.conky_text(teil))
    print("\n".join(zeilen))


if __name__ == "__main__":
    main()
